font.family: sans-serif
font.sans-serif: Arial, Helvetica, Liberation Sans, DejaVu Sans
font.size: 7
axes.titlesize: 8
axes.labelsize: 7
xtick.labelsize: 6
ytick.labelsize: 6
legend.fontsize: 6
legend.frameon: False
axes.linewidth: 0.5
axes.spines.top: False
axes.spines.right: False
axes.prop_cycle: cycler('color', ['0465B0', 'A72C09', '25B6A3', 'C7952E', '763F7B', 'A788ED', '407B46', 'B76672'])
xtick.major.width: 0.5
ytick.major.width: 0.5
xtick.major.size: 2.5
ytick.major.size: 2.5
lines.linewidth: 1.0
lines.markersize: 3
figure.constrained_layout.use: True
savefig.dpi: 200
pdf.fonttype: 42
svg.fonttype: none
